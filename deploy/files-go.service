[Unit]
Description=files-go file index and media server
After=network-online.target local-fs.target
RequiresMountsFor=/data
Wants=network-online.target

[Service]
User=files
Group=files
SupplementaryGroups=render
ExecStart=/opt/files-go/files-go -d /data/files-go
Environment=TMPDIR=/data/files-go/tmp
Restart=on-failure
Nice=5
IOSchedulingClass=idle
# The indexed volume is read-only for this service; only its data directory
# (config "data") is writable. Create that directory before starting.
ProtectSystem=strict
ReadOnlyPaths=/data
ReadWritePaths=/data/files-go
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
