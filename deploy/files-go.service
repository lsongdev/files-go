[Unit]
Description=files-go file index and media server
After=network-online.target local-fs.target
RequiresMountsFor=/data
Wants=network-online.target

[Service]
User=files
Group=files
SupplementaryGroups=render
ExecStart=/data/files-go/files-go -d /data/files-go
Restart=on-failure
Nice=5
IOSchedulingClass=idle
# The indexed volume is read-only for this service; only its -d directory,
# which holds the binary, config, index, caches and temporary files, is
# writable. Create that directory before starting.
ProtectSystem=strict
ReadOnlyPaths=/data
ReadWritePaths=/data/files-go
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
